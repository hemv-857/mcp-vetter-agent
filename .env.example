# Copy to .env (gitignored) and fill in what you use.

# Optional: live GPT semantic review inside full_audit.
# Without it, pass allow_degraded=true and findings park as needs_review.
OPENAI_API_KEY=

# TrueForge model provider keys are entered in the UI (Settings -> Models),
# not here.

# Required to file GitHub security issues from the approval gate (repo scope).
# The token stays on the probe server; the console never sees it.
GITHUB_TOKEN=

# Browser origins allowed to reach the MCP endpoint. Defaults to the Vite
# dev/preview ports on localhost.
# VETTING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dev only. Replays a captured report when the security_scanner engine is not
# installed. Replayed reports are tagged sample_data=true and labelled in the UI.
# VETTING_DEV_FIXTURES=1
